{
  "version": 2,
  "routes": [
    { "source": "/report", "destination": "/report/index.html" },
    { "source": "/report/", "destination": "/report/index.html" },
    { "source": "/tv-login", "destination": "/tv-login.html" },
    { "source": "/tv-login/", "destination": "/tv-login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
